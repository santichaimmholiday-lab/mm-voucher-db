generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model tb_master_locatype {
  id            String               @id @default(uuid())
  locatype_code String               @unique
  locatype_name String
  locatype_desc String?
  is_deleted    Boolean              @default(false)
  created_by    String?
  created_ip    String?
  created_at    DateTime             @default(now())
  updated_by    String?
  updated_ip    String?
  updated_at    DateTime             @updatedAt
  deleted_by    String?
  deleted_ip    String?
  deleted_at    DateTime?
  locations     tb_master_location[]
}

model tb_master_location {
  id                  String              @id @default(uuid())
  location_code       String              @unique
  location_name       String
  location_address    String?
  location_locatype   String?
  is_deleted          Boolean             @default(false)
  created_by          String?
  created_ip          String?
  created_at          DateTime            @default(now())
  updated_by          String?
  updated_ip          String?
  updated_at          DateTime            @updatedAt
  deleted_by          String?
  deleted_ip          String?
  deleted_at          DateTime?
  locatype            tb_master_locatype? @relation(fields: [location_locatype], references: [id])
  vouchers_attraction tb_voucher[]        @relation("AttractionRelation")
  vouchers_hotel      tb_voucher[]        @relation("HotelRelation")
  vouchers_pickup     tb_voucher[]        @relation("PickupHotelRelation")
  vouchers_tour       tb_voucher[]        @relation("TourRelation")
}

model tb_customer {
  id           String    @id @default(uuid())
  cus_nickname String    @unique
  cus_name     String
  cus_address  String?
  cus_tel      String?
  cus_fax      String?
  cus_note     String?
  is_deleted   Boolean   @default(false)
  created_by   String?
  created_ip   String?
  created_at   DateTime  @default(now())
  updated_by   String?
  updated_ip   String?
  updated_at   DateTime  @updatedAt
  deleted_by   String?
  deleted_ip   String?
  deleted_at   DateTime?
}

model tb_system_settings {
  id                String   @id @default(uuid())
  company_name      String?
  company_name_th   String?
  company_address   String?
  company_tel       String?
  company_email     String?
  company_web       String?
  tat_license       String?
  logo_image_path   String?
  qr_code_path      String?
  condition_booking String?
  condition_hotel   String?
  condition_tour    String?
  updated_at        DateTime @updatedAt
}

model tb_voucher {
  id                 String              @id @default(uuid())
  voucher_no         String              @unique
  voucher_issue_date DateTime
  voucher_status     String              @default("Waiting")
  voucher_guest_name String
  guest_mobile       String?
  pax_adult          Int                 @default(1)
  pax_child          Int                 @default(0)
  child_age          String?
  pax_infant         Int                 @default(0)
  voucher_type       String
  voucher_company    String?
  hotel_id           String?
  check_in_date      DateTime?
  check_out_date     DateTime?
  nights             Int?
  rooms              Int?
  room_type          String?
  attraction_id      String?
  visit_date         DateTime?
  person_count       Int?
  entrance_ticket    String?
  tour_id            String?
  pickup_hotel_id    String?
  pickup_time        String?
  conf_no            String?
  payment_by         String?
  remarks            String?
  conf_by            String?
  is_deleted         Boolean             @default(false)
  created_by         String?
  created_ip         String?
  created_at         DateTime            @default(now())
  updated_by         String?
  updated_ip         String?
  updated_at         DateTime            @updatedAt
  deleted_by         String?
  deleted_ip         String?
  deleted_at         DateTime?
  attraction         tb_master_location? @relation("AttractionRelation", fields: [attraction_id], references: [id])
  hotel              tb_master_location? @relation("HotelRelation", fields: [hotel_id], references: [id])
  pickup_hotel       tb_master_location? @relation("PickupHotelRelation", fields: [pickup_hotel_id], references: [id])
  tour               tb_master_location? @relation("TourRelation", fields: [tour_id], references: [id])
}

model tb_user {
  id         String    @id @default(uuid())
  username   String    @unique
  email      String    @unique
  password   String
  role       String    @default("User")
  is_deleted Boolean   @default(false)
  deleted_by String?
  deleted_at DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
}

model tb_role_permission {
  id          String   @id @default(uuid())
  role        String
  module      String
  can_read    Boolean  @default(false)
  can_add     Boolean  @default(false)
  can_edit    Boolean  @default(false)
  can_delete  Boolean  @default(false)
  can_printx  Boolean  @default(false)
  can_confirm Boolean  @default(false)
  can_upload  Boolean  @default(false)

  @@unique([role, module])
}
